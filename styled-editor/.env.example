# styled-editor 固定值配置
# 用法：复制到你的工作目录并改值  cp styled-editor/.env.example .env
# 生成 HTML 时自动注入；也可对已生成的文件补注入  styled-editor/scripts/inject-env.sh 文件.html

# 公众号名 / 作者署名（→ 模板占位符 {{ACCOUNT_NAME}}）
ACCOUNT_NAME=示例公众号名

# 页脚一句话签名（→ {{FOOTER_SLOGAN}}）
FOOTER_SLOGAN=平实地写，认真地过

# 结尾互动块第二行的转发语（→ {{ENDING_CTA}}）
ENDING_CTA=如果这篇文章对你有用，欢迎转发给可能需要的朋友。

# 插图生成（可选）：不配则只交付提示词，由用户手动生成
# OpenAI 兼容的 images/generations 接口；默认智谱 CogView 免费档
# IMAGE_API_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
# IMAGE_MODEL=cogview-3-flash
# IMAGE_API_KEY=你的key（不配时 gen-image.sh 会尝试读 ~/.pi/agent/models.json 里的智谱 key）
